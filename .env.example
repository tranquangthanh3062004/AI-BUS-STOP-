# Edge Device Configurations
DEVICE_ID=KIOSK_HANOI_001
CLOUD_API_URL=https://api.transport-assistant.vn
MQTT_BROKER=mqtt.transport-assistant.vn
MQTT_PORT=8883

# Local AI Models
LLM_MODEL_PATH=/models/llama-3-8b-instruct.Q4_K_M.gguf
STT_MODEL_PATH=/models/whisper-small-vi.bin
TTS_MODEL_PATH=/models/vits-vi-tts.onnx

# Sync Configurations
SYNC_INTERVAL_SECONDS=3600
OFFLINE_MODE_TIMEOUT_SECONDS=10

# Hardware
ENABLE_WATCHDOG=true
ENABLE_PIR_SENSOR=true
